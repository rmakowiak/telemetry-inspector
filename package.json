{
  "name": "telemetry-inspector",
  "version": "0.1.0",
  "description": "Watch the PostHog events your local n8n sends, live in the terminal.",
  "type": "module",
  "bin": {
    "telemetry-inspector": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
